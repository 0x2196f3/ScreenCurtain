<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.screencurtain">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:icon="@drawable/ic_launcher"
        android:label="Screen Curtain"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenCurtain">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TriggerActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <service
            android:name=".CurtainService"
            android:exported="false" />

        <service
            android:name=".CurtainTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_tile"
            android:label="Screen Curtain"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>